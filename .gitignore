# Home-directory repo: deny everything by default, allowlist only repo files.
# This prevents accidental commits of private data (.ssh, .claude.json, .Trash, ...).
/*

# --- Repo scaffolding (tracked) ---
!/.gitignore
!/CLAUDE.md
!/.clinerules
!/.agent-harness/
!/.agent-memory/
!/.agent-dashboard/
# generated/native artifacts inside the dashboard dir — never tracked
/.agent-dashboard/data.js
/.agent-dashboard/src/dashboard-server
/.agent-dashboard/src/*.log
!/.opencode/
/.opencode/*
!/.opencode/instructions.md

# --- n8n workflows (tracked; ship inactive, human activates in UI) ---
!/n8n/
!/n8n/workflows/

# --- CI/AI QA gate (tracked) ---
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ai-qa-gate.yml
!/.github/ai-qa-gate-prompt.md

# --- Workspace files (allowlisted for visibility, kept LOCAL-ONLY: public repo) ---
!/AGENTS.md
!/MEMORY.md
!/TOOLS.md
!/memory/

# --- Noise ---
.DS_Store
