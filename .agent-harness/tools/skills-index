#!/usr/bin/env python3
"""skills-index — regenerate .agent-harness/SKILLS-INDEX.md  (pipeline T4/S4 step)

Distilled 2026-09-10 from the skill delegation pipeline v1 (sources:
.agent-harness/skills-pipeline.md via QA-gated swarm research).
One row per SKILL.md file (not per top dir) so multi-skill packages like
anthropic-agent-skills index all of their members.

Usage: skills-index            # rewrite SKILLS-INDEX.md from skills dirs
Exit:  0 on success, 1 with usage error.
"""
import re, glob, os, sys
from pathlib import Path

if len(sys.argv) != 1:
    print(__doc__)
    sys.exit(1)

# Repo root = two levels up from .agent-harness/tools/ (c27: home paths deleted).
REPO = Path(__file__).resolve().parents[2]

lines = ["# SKILLS INDEX — auto-generated by tools/skills-index · regenerate after S2/S3/S4",
         "# status | name | audit | trigger (≤160chars)"]
bases = [("equipped", str(Path.home() / ".claude/skills")),
         ("staged", str(REPO / ".agent-memory/skills-inbox")),
         ("tool", str(REPO / ".agent-harness/tools"))]
count = 0
for tag, root in bases:
    if tag == "tool":
        for f in sorted(glob.glob(os.path.join(root, "*"))):
            if os.path.isdir(f) or f.endswith((".md", ".pyc", ".swp")):
                continue
            name = os.path.basename(f)
            text = open(f).read()
            m = re.search(r'"""([^"]+)', text)
            desc = re.sub(r"\s+", " ", m.group(1)).strip() if m else ""
            lines.append(f"tool\t{name}\tAUDIT-PASS\t{desc[:160]}")
            count += 1
        continue
    for f in sorted(glob.glob(os.path.join(root, "**", "SKILL.md"), recursive=True)):
        rel = os.path.relpath(f, root)
        if "/." in ("/" + rel) or rel.startswith("."):
            continue  # skip hidden dirs WITHIN the library, not the root path itself
        name = os.path.basename(f).replace(".md", "") if os.path.basename(os.path.dirname(f)) == os.path.basename(os.path.dirname(os.path.dirname(f))) else os.path.dirname(f).split(os.sep)[-1]
        # prefer the actual slug: dir containing this SKILL.md; for nested
        # name/name/SKILL.md layouts both levels agree, so dirname wins
        name = os.path.basename(os.path.dirname(f))
        text = open(f).read()
        m = re.search(r"^description:\s*(?:>-?\s*\n)?((?:\s+[^\n]+\n?)+)", text, re.M)
        desc = re.sub(r"\s+", " ", m.group(1)).strip() if m else ""
        fm_name = re.search(r"^name:\s*(.+)$", text[:2000], re.M)
        audit = "AUDIT-PASS" if "audited: PASS" in text else "unaudited"
        lines.append(f"{tag}\t{fm_name.group(1).strip() if fm_name else name}\t{audit}\t{desc[:160]}")
        count += 1
out = str(REPO / ".agent-harness/SKILLS-INDEX.md")
open(out, "w").write("\n".join(lines) + "\n")
print(f"skills-index: wrote {count} entries -> {out}")
